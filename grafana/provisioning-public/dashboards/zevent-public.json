        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (  SELECT twitch_id, ts, online, game, viewers FROM streamer_sample_v  WHERE ts = (SELECT max(ts) FROM snapshot) AND twitch_id IN ($streamer)), changed AS (  SELECT c.twitch_id, max(s.ts) AS at FROM cur c JOIN streamer_sample_v s USING (twitch_id)  WHERE s.online <> c.online OR s.game IS DISTINCT FROM c.game GROUP BY c.twitch_id) SELECT st.display AS \"Streamer\", c.online AS \"Online\", c.game AS \"Game\", c.viewers AS \"Viewers\",        extract(epoch FROM c.ts - coalesce(ch.at, st.first_seen)) AS \"Since\", st.login AS login FROM cur c JOIN streamer_v st USING (twitch_id) LEFT JOIN changed ch USING (twitch_id) ORDER BY c.online DESC, c.viewers DESC",
          "format": "table",
          "refId": "A"
        }
      ],
