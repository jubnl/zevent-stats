    {
      "id": 14,
      "type": "timeseries",
      "title": "External donations per interval (global gain minus streamer gains)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), sum(g) - sum(sg) AS \"External\" FROM (  SELECT ts, donation_total - donation_dup - lag(donation_total - donation_dup) OVER ( ORDER BY ts) AS g FROM snapshot_v WHERE $__timeFilter(ts)) gl JOIN (  SELECT ts, sum(delta) AS sg FROM (    SELECT ts, donation_total - lag(donation_total) OVER (PARTITION BY twitch_id ORDER BY ts) AS delta FROM streamer_sample_v WHERE NOT derived AND $__timeFilter(ts)  ) x GROUP BY ts) st USING (ts) WHERE g IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": true,
