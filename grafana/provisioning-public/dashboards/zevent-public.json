            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT sn.donation_total - sn.donation_dup - sum(s.donation_total) FROM snapshot_v sn JOIN streamer_sample_v s USING (ts) WHERE NOT s.derived AND sn.ts = (SELECT max(ts) FROM snapshot) GROUP BY sn.donation_total, sn.donation_dup",
