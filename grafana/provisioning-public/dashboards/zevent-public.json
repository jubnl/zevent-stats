          },
          "rawQuery": true,
          "rawSql": "SELECT sn.ts AS time, sn.donation_total - sn.donation_dup - sum(s.donation_total) FILTER (WHERE NOT s.derived) AS \"External\", coalesce(sum(s.donation_total) FILTER (WHERE s.derived), 0) AS \"Mirrored (mistermv)\", sn.donation_dup AS \"Double-counted in total (mistermv)\" FROM snapshot_v sn JOIN streamer_sample_v s USING (ts) WHERE $__timeFilter(sn.ts) GROUP BY sn.ts, sn.donation_total, sn.donation_dup ORDER BY 1",
