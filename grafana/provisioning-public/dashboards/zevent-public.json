        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Global total minus the sum of streamer counters, with two corrections since 01:08 UTC on Sept 5: the derived \"mistermv (private counter)\" row is left out (it mirrors Domingo's counter, which the global total already counts once), and mistermv's other increments are subtracted from the global total, which carries each of them twice. See the \"MisterMV's private counter\" tile for both amounts."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "MisterMV's private counter",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(s.donation_total) FILTER (WHERE s.derived), 0) AS \"Mirrored\", max(sn.donation_dup) AS \"Other\", coalesce(sum(s.donation_total) FILTER (WHERE s.derived), 0) + max(sn.donation_dup) AS \"Total\" FROM snapshot_v sn JOIN streamer_sample_v s USING (ts) WHERE sn.ts = (SELECT max(ts) FROM snapshot)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "currencyEUR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "description": "Mirrored: Mirrored donations from Domingo. Other: mistermv's other increments since then, which the global total carries twice. Total: the sum of both."
    },
