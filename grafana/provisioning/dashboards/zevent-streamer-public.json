        "definition": "SELECT st.display AS __text, st.twitch_id AS __value FROM streamer_v st JOIN streamer_sample_v s USING (twitch_id) WHERE s.ts = (SELECT max(ts) FROM snapshot) AND NOT st.derived ORDER BY s.donation_total DESC",
