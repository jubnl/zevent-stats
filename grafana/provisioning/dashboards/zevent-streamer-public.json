          "rawSql": "WITH g AS (  SELECT s.twitch_id, sum(s.gain) AS gained FROM streamer_sample_v s  WHERE $__timeFilter(s.ts) AND s.gain IS NOT NULL GROUP BY s.twitch_id) , v AS (  SELECT sum(x.viewers * least(x.gap_s, 300)) / 3600.0 AS viewer_hours  FROM streamer_sample_v x JOIN streamer_v st USING (twitch_id)  WHERE $__timeFilter(x.ts) AND NOT st.derived AND x.twitch_id IN ($streamer) AND true AND x.gap_s IS NOT NULL) SELECT (SELECT coalesce(sum(g.gained), 0) FROM g JOIN streamer_v st USING (twitch_id)         WHERE NOT st.derived AND g.twitch_id IN ($streamer) AND true) / nullif(v.viewer_hours, 0) FROM v",
          "format": "table",
          "refId": "A"
        }
