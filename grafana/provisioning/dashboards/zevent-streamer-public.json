          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT min(r) FROM (SELECT twitch_id, rank() OVER (ORDER BY donation_total DESC) AS r FROM streamer_sample_v WHERE ts = (SELECT max(ts) FROM snapshot) AND NOT derived) x WHERE twitch_id IN ($streamer)",
          "format": "table",
          "refId": "A"
        }
