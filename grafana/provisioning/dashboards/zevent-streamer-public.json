    {
      "id": 1,
      "type": "stat",
      "title": "Donations",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(s.donation_total), 0) FROM streamer_sample_v s JOIN streamer_v st USING (twitch_id) WHERE NOT st.derived AND s.twitch_id IN ($streamer) AND s.ts = (SELECT max(ts) FROM snapshot)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
