  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Viewers de chaque streamer au fil du temps ($location, $streamer)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
