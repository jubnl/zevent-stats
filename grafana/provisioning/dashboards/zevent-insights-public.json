    {
      "id": 1,
      "type": "stat",
      "title": "Rythme des dons, 10 derni\u00e8res min",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (SELECT ts, donation_total FROM snapshot ORDER BY ts DESC LIMIT 1), past AS (SELECT sn.donation_total FROM snapshot sn, cur WHERE sn.ts <= cur.ts - interval '10 minutes'          ORDER BY sn.ts DESC LIMIT 1) SELECT (cur.donation_total - past.donation_total) / 10 FROM cur, past",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "currencyEUR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Gain du total de l'\u00e9v\u00e9nement par minute sur les 10 derni\u00e8res minutes de donn\u00e9es."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rythme moyen depuis le d\u00e9but",
      "datasource": {
