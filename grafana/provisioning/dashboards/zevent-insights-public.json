              },
              {
                "id": "displayName",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Par viewer-heure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gagn\u00e9"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
