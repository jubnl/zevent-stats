    {
      "id": 4,
      "type": "stat",
      "title": "Prochain million dans",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (SELECT ts, donation_total FROM snapshot ORDER BY ts DESC LIMIT 1), past AS (SELECT sn.donation_total FROM snapshot sn, cur WHERE sn.ts <= cur.ts - interval '10 minutes'          ORDER BY sn.ts DESC LIMIT 1) SELECT CASE WHEN cur.donation_total > past.donation_total THEN ((floor(cur.donation_total / 1e6) + 1) * 1e6 - cur.donation_total) / ((cur.donation_total - past.donation_total) / 600.0) END FROM cur, past",
