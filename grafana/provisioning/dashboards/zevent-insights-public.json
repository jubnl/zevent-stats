        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT coalesce(x.game, '(sans jeu)') AS \"Jeu\", sum(least(x.gap_s, 300)) / 3600.0 AS \"Heures\",        count(DISTINCT x.twitch_id) AS \"Streamers\", sum(x.viewers * least(x.gap_s, 300)) / 3600.0 AS \"Viewer-heures\" FROM streamer_sample_v x JOIN streamer_v st USING (twitch_id) WHERE $__timeFilter(x.ts) AND NOT st.derived AND coalesce(st.location, '') ~ '^(${location:regex})$' AND x.online AND x.gap_s IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 25",
