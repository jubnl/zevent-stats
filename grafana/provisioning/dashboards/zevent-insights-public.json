          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Total de l'\u00e9v\u00e9nement par minute, sur tout l'\u00e9v\u00e9nement."
    },
    {
