        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "zevent-pg"
        },
        "query": "SELECT CASE location WHEN 'LAN' THEN 'On site (LAN)' ELSE 'Remote (online)' END AS __text, location AS __value FROM streamer_v WHERE location IS NOT NULL GROUP BY location ORDER BY location",
        "definition": "SELECT CASE location WHEN 'LAN' THEN 'On site (LAN)' ELSE 'Remote (online)' END AS __text, location AS __value FROM streamer_v WHERE location IS NOT NULL GROUP BY location ORDER BY location",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
