    {
      "id": 9,
      "type": "barchart",
      "title": "Donations by hour of the day (Europe/Paris)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT to_char(h, 'FM00\"h\"') AS \"Hour\", sum(delta) AS \"Donated\" FROM (  SELECT extract(hour FROM ts AT TIME ZONE 'Europe/Paris') AS h,          donation_total - lag(donation_total) OVER (ORDER BY ts) AS delta  FROM snapshot WHERE $__timeFilter(ts)) d WHERE delta IS NOT NULL GROUP BY h ORDER BY h",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xField": "Hour",
        "showValue": "never",
        "barWidth": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Event total gained per hour of the day, summed over the selected range (all locations)."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Donations per viewer-hour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH v AS (  SELECT x.twitch_id, sum(x.viewers * least(x.gap_s, 300)) / 3600.0 AS viewer_hours,          sum(least(x.gap_s, 300)) FILTER (WHERE x.online) / 3600.0 AS hours  FROM streamer_sample_v x WHERE $__timeFilter(x.ts) AND x.gap_s IS NOT NULL GROUP BY x.twitch_id), g AS (  SELECT s.twitch_id, sum(s.gain) AS gained FROM streamer_sample_v s  WHERE $__timeFilter(s.ts) AND s.gain IS NOT NULL GROUP BY s.twitch_id) SELECT st.profile_url AS \"Avatar\", st.display AS \"Streamer\", g.gained / v.viewer_hours AS \"Per viewer-hour\", g.gained AS \"Gained\", v.viewer_hours AS \"Viewer-hours\", v.hours AS \"Hours\", st.login AS login FROM g JOIN v USING (twitch_id) JOIN streamer_v st USING (twitch_id) WHERE NOT st.derived AND v.viewer_hours >= 100 AND coalesce(st.location, '') ~ '^(${location:regex})$' ORDER BY 3 DESC LIMIT 25",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Avatar"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "image"
                }
              },
              {
                "id": "custom.width",
                "value": 44
              },
              {
                "id": "displayName",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Per viewer-hour"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gained"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hours"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Streamer"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on Twitch",
                    "url": "https://twitch.tv/${__data.fields.login}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "login"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "description": "Gained in the selected range divided by viewer-hours (viewers summed over time): how much a community gives relative to its size. Streamers with fewer than 100 viewer-hours are left out."
    },
    {
      "id": 11,
      "type": "table",
      "title": "Trending now (last 15 minutes)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (SELECT max(ts) AS ts FROM snapshot), n AS (SELECT twitch_id, donation_total, viewers FROM streamer_sample_v, cur WHERE streamer_sample_v.ts = cur.ts), p AS (SELECT DISTINCT ON (ss.twitch_id) ss.twitch_id, ss.donation_total, ss.viewers FROM streamer_sample_v ss, cur       WHERE ss.ts BETWEEN cur.ts - interval '60 minutes' AND cur.ts - interval '15 minutes'       ORDER BY ss.twitch_id, ss.ts DESC) SELECT st.profile_url AS \"Avatar\", st.display AS \"Streamer\", n.donation_total - p.donation_total AS \"Gained\", n.viewers AS \"Viewers\", n.viewers - p.viewers AS \"Viewers change\", st.login AS login FROM n JOIN p USING (twitch_id) JOIN streamer_v st USING (twitch_id) WHERE NOT st.derived AND coalesce(st.location, '') ~ '^(${location:regex})$' ORDER BY 3 DESC LIMIT 25",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
