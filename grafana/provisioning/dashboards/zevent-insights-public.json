            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Streamer"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ouvrir sur Twitch",
                    "url": "https://twitch.tv/${__data.fields.login}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
