    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Donations gained per interval, by location",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(d.ts, $__interval), coalesce(st.location, 'Unknown') AS metric, sum(d.gain) AS value FROM streamer_sample_v d JOIN streamer_v st USING (twitch_id) WHERE $__timeFilter(d.ts) AND NOT d.derived AND d.gain IS NOT NULL AND coalesce(st.location, '') ~ '^(${location:regex})$' GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": true,
            "drawStyle": "bars",
