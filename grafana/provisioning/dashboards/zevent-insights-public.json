  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Donation rate, last 10 min",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (SELECT ts, donation_total FROM snapshot ORDER BY ts DESC LIMIT 1), past AS (SELECT sn.donation_total FROM snapshot sn, cur WHERE sn.ts <= cur.ts - interval '10 minutes'          ORDER BY sn.ts DESC LIMIT 1) SELECT (cur.donation_total - past.donation_total) / 10 FROM cur, past",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "currencyEUR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Event total gained per minute over the last 10 minutes of data."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Average rate since the start",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT (max(donation_total) - min(donation_total)) / greatest(extract(epoch FROM max(ts) - min(ts)) / 60, 1) FROM snapshot",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "currencyEUR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Event total per minute, whole event."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Next million",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT (floor(donation_total / 1e6) + 1) * 1e6 FROM snapshot ORDER BY ts DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "currencyEUR",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Next million in",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH cur AS (SELECT ts, donation_total FROM snapshot ORDER BY ts DESC LIMIT 1), past AS (SELECT sn.donation_total FROM snapshot sn, cur WHERE sn.ts <= cur.ts - interval '10 minutes'          ORDER BY sn.ts DESC LIMIT 1) SELECT CASE WHEN cur.donation_total > past.donation_total THEN ((floor(cur.donation_total / 1e6) + 1) * 1e6 - cur.donation_total) / ((cur.donation_total - past.donation_total) / 600.0) END FROM cur, past",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "dtdurations",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "At the donation rate of the last 10 minutes."
    },
    {
      "id": 5,
      "type": "row",
      "title": "Milestones and moments",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Millions, one by one",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH m AS (  SELECT ts, floor(max(donation_total) OVER (ORDER BY ts) / 1e6) AS mil FROM snapshot), c AS (  SELECT ts, mil, lag(mil) OVER (ORDER BY ts) AS prev FROM m), x AS (SELECT ts, mil FROM c WHERE prev IS NOT NULL AND mil > prev) SELECT mil * 1e6 AS \"Milestone\", ts AS \"Reached at\",        extract(epoch FROM ts - lag(ts) OVER (ORDER BY ts)) AS \"After the previous\",        extract(epoch FROM ts - (SELECT min(ts) FROM snapshot)) AS \"Since the start\" FROM x ORDER BY mil DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Milestone"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "After the previous"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since the start"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "description": "When the event total crossed each round million (running maximum, so a counter dip cannot cross the same million twice)."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Largest single-minute gains",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH e AS (  SELECT s.ts, s.twitch_id, s.gain AS delta FROM streamer_sample_v s  WHERE $__timeFilter(s.ts) AND NOT s.derived AND s.gain > 0 AND s.gap_s <= 300  ORDER BY s.gain DESC LIMIT 200) SELECT e.ts AS \"Time\", st.display AS \"Streamer\", e.delta AS \"Gain\", st.login AS login FROM e JOIN streamer_v st USING (twitch_id) WHERE st.login NOT IN ('zevent', 'zeventplays') AND coalesce(st.location, '') ~ '^(${location:regex})$' AND NOT EXISTS (SELECT 1 FROM streamer_sample_v p WHERE p.twitch_id = e.twitch_id                 AND p.ts < e.ts AND p.ts >= e.ts - interval '10 minutes' AND p.gain <= -0.9 * e.delta) ORDER BY e.delta DESC LIMIT 25",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Gain"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Streamer"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on Twitch",
                    "url": "https://twitch.tv/${__data.fields.login}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "login"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "description": "Gains within one minute of a streamer's counter. The organisation's own channels (ZEVENT, ZEventPlays) are left out: their counters move in lumps (tickets, shop) and, before Sept 4 22:58 CEST, come from a 30-minute source. Gains are measured between two samples at most 5 minutes apart, so a gap in the data is not counted as one minute). A restore after an upstream blip (a counter dropping to 0 and coming back minutes later) is left out: rows whose streamer lost at least 90% of the amount in the previous 10 minutes are skipped."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Patterns",
      "collapsed": false,
