      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT sn.donation_total - sum(s.donation_total) FROM snapshot sn JOIN streamer_sample_v s USING (ts) WHERE NOT s.derived AND sn.ts = (SELECT max(ts) FROM snapshot) GROUP BY sn.donation_total",
          "format": "table",
          "refId": "A"
