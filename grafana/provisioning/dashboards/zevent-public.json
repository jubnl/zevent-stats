      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), sum(delta) AS \"Dons\" FROM (  SELECT ts, donation_total - lag(donation_total) OVER (ORDER BY ts) AS delta  FROM snapshot WHERE $__timeFilter(ts)) d WHERE delta IS NOT NULL GROUP BY 1 ORDER BY 1",
