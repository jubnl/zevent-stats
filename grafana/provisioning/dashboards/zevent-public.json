    {
      "id": 14,
      "type": "timeseries",
      "title": "Dons par intervalle",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
