    {
      "id": 8,
      "type": "stat",
      "title": "Viewer-hours",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(x.viewers * least(x.gap_s, 300)), 0) / 3600.0 FROM streamer_sample_v x JOIN streamer_v st USING (twitch_id) WHERE $__timeFilter(x.ts) AND NOT st.derived AND x.twitch_id IN ($streamer) AND coalesce(st.location, '') ~ '^(${location:regex})$' AND x.gap_s IS NOT NULL",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Audience size over time, in viewer-hours: the viewer count of the streamers matching the Location and Streamer filters, summed minute by minute over the selected range (each sample counts the time since the previous one, capped at 5 minutes so gaps in the data do not count). One viewer watching for an hour is one viewer-hour; 1,000 viewers for 2 hours are 2,000 viewer-hours."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Hours streamed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(least(s.gap_s, 300)) FILTER (WHERE s.online), 0) / 3600.0 FROM streamer_sample_v s JOIN streamer_v st USING (twitch_id) WHERE NOT st.derived AND coalesce(st.location, '') ~ '^(${location:regex})$' AND $__timeFilter(s.ts) AND s.twitch_id IN ($streamer) AND s.gap_s IS NOT NULL",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "suffix: h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Total time live, summed over the streamers matching the Location and Streamer filters, within the selected time range. Each live sample counts the minute since the previous sample (capped at 5 minutes, so gaps in the data do not count)."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Donations per viewer-hour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "zevent-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "zevent-pg"
          },
          "rawQuery": true,
          "rawSql": "WITH g AS (  SELECT s.twitch_id, sum(s.gain) AS gained FROM streamer_sample_v s  WHERE $__timeFilter(s.ts) AND s.gain IS NOT NULL GROUP BY s.twitch_id) , v AS (  SELECT sum(x.viewers * least(x.gap_s, 300)) / 3600.0 AS viewer_hours  FROM streamer_sample_v x JOIN streamer_v st USING (twitch_id)  WHERE $__timeFilter(x.ts) AND NOT st.derived AND x.twitch_id IN ($streamer) AND coalesce(st.location, '') ~ '^(${location:regex})$' AND x.gap_s IS NOT NULL) SELECT (SELECT coalesce(sum(g.gained), 0) FROM g JOIN streamer_v st USING (twitch_id)         WHERE NOT st.derived AND g.twitch_id IN ($streamer) AND coalesce(st.location, '') ~ '^(${location:regex})$') / nullif(v.viewer_hours, 0) FROM v",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "currencyEUR",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "How much the community gives relative to its size: donations gained by the streamers matching the Location and Streamer filters over the selected range, divided by their viewer-hours (the viewer count summed minute by minute over the same range, in hours). One viewer watching for an hour is one viewer-hour, so 5 \u20ac means 5 \u20ac raised for every hour watched by one viewer. Donations not tied to a streamer (tickets, shop, anonymous) are not included."
    },
