      {
        "name": "location",
        "label": "Lieu",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "zevent-pg"
        },
        "query": "SELECT CASE location WHEN 'LAN' THEN 'Sur place (LAN)' ELSE '\u00c0 distance (online)' END AS __text, location AS __value FROM streamer_v WHERE location IS NOT NULL GROUP BY location ORDER BY location",
        "definition": "SELECT CASE location WHEN 'LAN' THEN 'Sur place (LAN)' ELSE '\u00c0 distance (online)' END AS __text, location AS __value FROM streamer_v WHERE location IS NOT NULL GROUP BY location ORDER BY location",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "current": {
          "selected": true,
          "text": [
            "Sur place (LAN)"
          ],
          "value": [
            "LAN"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "streamer",
        "label": "Streamer",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "zevent-pg"
        },
        "query": "SELECT display AS __text, twitch_id AS __value FROM streamer_v st WHERE coalesce(st.location, '') ~ '^(${location:regex})$' ORDER BY lower(display)",
        "definition": "SELECT display AS __text, twitch_id AS __value FROM streamer_v st WHERE coalesce(st.location, '') ~ '^(${location:regex})$' ORDER BY lower(display)",
